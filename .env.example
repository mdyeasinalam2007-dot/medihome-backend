# ============================================================
# MediHome .env  (never commit .env). Optional check: node scripts/doctor.js
# ============================================================

# 1) DATABASE - PostgreSQL (must start with postgresql://). REQUIRED: there is no built-in fallback.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Optional: direct (non-pooled) URL for one-off schema commands such as `prisma db push`. Not read by the app.
DIRECT_URL=""

# 2) LOGIN SESSIONS
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# 3) GOOGLE LOGIN   redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4) FACEBOOK LOGIN redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# 5) PAYMENTS: DEMO MODE ONLY. MediHome collects no real payments, so the PAYMENT_MODE, MEDIHOME_PAYMENT_DESTINATION,
#    BKASH_* and ALLOW_MOCK_PAYMENTS values below are currently NOT used (kept for a possible future payment phase).
#
#
#
PAYMENT_MODE="auto"
# (unused in demo mode)
MEDIHOME_PAYMENT_DESTINATION=""
# REQUIRED for hospital approvals: long secret (16+ characters) for the admin page /owner
OWNER_KEY=""
# (unused in demo mode)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
ALLOW_MOCK_PAYMENTS="false"

# 6) FEES (BDT)
SERVICE_FEE_BDT="10"
AMBULANCE_FEE_BDT="10"
HOSPITAL_REG_FEE_BDT="100"
HOSPITAL_MONTHLY_FEE_BDT="50"

# 7) AI CONSULTANT
#   AI_PROVIDER: auto (default) = local Ollama if OLLAMA_MODEL is set, else Gemini if GEMINI_API_KEY is set, else demo mode
#                ollama = only the free local model | gemini = only Google cloud (your data is sent to Google)
AI_PROVIDER="auto"
# Free LOCAL model through Ollama (https://ollama.com). Example: gemma3:4b  (see AI-CONSULTANT.md for hardware)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL=""
OLLAMA_VISION_MODEL=""
# Google cloud (optional). Keys starting AIza... and AQ.... both work. Sent only in a request header, never in a URL.
GEMINI_API_KEY=""
GEMINI_MODEL=""
# Optional: backup model and per-attempt timeout (blank = built-in defaults, see lib/ai.ts)
GEMINI_FALLBACK_MODEL=""
GEMINI_TIMEOUT_MS=""
# Optional live web search through YOUR OWN SearXNG server, e.g. http://localhost:8080
SEARXNG_URL=""

# 8) EMAIL for "Forgot password" (optional). Uses Resend (resend.com) over HTTPS; no extra package.
#    Blank = on localhost the reset link is printed in the terminal; in production no email can be sent.
RESEND_API_KEY=""
MAIL_FROM=""

# 9) FILE STORAGE (S3-compatible, e.g. Neon object storage). NOT used yet: photos are still stored in the database.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="assets"
