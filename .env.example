# ============================================================
# MediHome .env  (never commit .env). Optional check: node scripts/doctor.js
# ============================================================

# 1) DATABASE - PostgreSQL (must start with postgresql://)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# 2) LOGIN SESSIONS
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# 3) GOOGLE LOGIN   redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4) FACEBOOK LOGIN redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# 5) PAYMENTS (bKash)
#   auto   (default): official bKash checkout if the BKASH_* values below are filled,
#                     otherwise Send Money to MEDIHOME_PAYMENT_DESTINATION,
#                     otherwise simulated TEST MODE (never in production)
#   manual: always Send Money to MEDIHOME_PAYMENT_DESTINATION
PAYMENT_MODE="auto"
# Your bKash number, e.g. +8801XXXXXXXXX. Server-only. Shown only to the signed-in person who is paying.
MEDIHOME_PAYMENT_DESTINATION=""
# Long secret (16+ characters) for the payment verification page /owner/payments
OWNER_KEY=""
# Only if bKash gave you merchant/API credentials
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
ALLOW_MOCK_PAYMENTS="false"

# 6) FEES (BDT)
SERVICE_FEE_BDT="10"
AMBULANCE_FEE_BDT="10"
HOSPITAL_REG_FEE_BDT="100"
HOSPITAL_MONTHLY_FEE_BDT="50"

# 7) AI CONSULTANT
#   AI_PROVIDER: auto (default) = local Ollama if OLLAMA_MODEL is set, else Gemini if GEMINI_API_KEY is set, else demo mode
#                ollama = only the free local model | gemini = only Google cloud (your data is sent to Google)
AI_PROVIDER="auto"
# Free LOCAL model through Ollama (https://ollama.com). Example: gemma3:4b  (see AI-CONSULTANT.md for hardware)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL=""
OLLAMA_VISION_MODEL=""
# Google cloud (optional). Keys starting AIza... and AQ.... both work
GEMINI_API_KEY=""
GEMINI_MODEL=""
# Optional live web search through YOUR OWN SearXNG server, e.g. http://localhost:8080
SEARXNG_URL=""

# 8) EMAIL for "Forgot password" (optional). Uses Resend (resend.com) over HTTPS; no extra package.
#    Blank = on localhost the reset link is printed in the terminal; in production no email can be sent.
RESEND_API_KEY=""
MAIL_FROM=""
