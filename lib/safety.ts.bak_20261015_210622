// Safety layer: runs in code BEFORE any model is called. Not just a prompt.
export const MAX_FILE = 5_000_000;
export const clean = (t: any, max = 4000) => String(t || "").replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, "").slice(0, max);

const EMERGENCY_PATTERNS: RegExp[] = [
  /chest (pain|tightness|pressure)/i, /heart attack/i, /(can'?t|cannot|unable to) breathe/i, /(difficulty|trouble) breathing/i, /shortness of breath/i,
  /face (is )?drooping|slurred speech|sudden (weakness|numbness)|\bstroke\b/i, /unconscious|passed out|not responding|collapsed/i, /seizure|convulsion/i,
  /(heavy|severe|uncontrolled) bleeding|bleeding (won'?t|will not) stop/i, /overdose|poison(ed|ing)?\b|swallowed (bleach|acid|pesticide)/i, /anaphyla|throat (is )?(closing|swelling)/i,
  /suicid|kill (myself|me)|end my life|self[- ]?harm|want to die/i,
  /বুকে ব্যথা|বুক ব্যথা|হার্ট অ্যাটাক|শ্বাস ?কষ্ট|শ্বাস নিতে (পারছি না|কষ্ট)|অজ্ঞান|খিঁচুনি|স্ট্রোক|প্রচুর রক্ত|রক্ত বন্ধ হচ্ছে না|বিষ খে|আত্মহত্যা|মরে যেতে চাই/,
];
export const isEmergency = (text: string) => EMERGENCY_PATTERNS.some((r) => r.test(String(text || "")));
