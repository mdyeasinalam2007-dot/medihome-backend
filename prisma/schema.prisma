generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  HOSPITAL
  AMBULANCE
}
enum AmbStatus {
  PENDING
  ACCEPTED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}
enum SubStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  ACTIVE
  PAST_DUE
  SUSPENDED
}
enum BookingType {
  DOCTOR
  BED
  BLOOD
  TEST
}
enum BookingStatus {
  REQUESTED
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  REFUND_PENDING
  REFUNDED
}
enum PayPurpose {
  BOOKING
  REGISTRATION
  SUBSCRIPTION
  AMBULANCE_FEE
}
enum PayStatus {
  INITIATED
  PENDING_VERIFICATION
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  passwordHash  String?
  role          Role      @default(PATIENT)
  hospital      Hospital?
  ambulanceProvider AmbulanceProvider?
  ambulanceBookings AmbulanceBooking[]
  bookings      Booking[]
  payments      Payment[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Hospital {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String    @default("")
  phone         String    @default("")
  address       String    @default("")
  location      String    @default("")
  description   String    @default("")
  facilities    String    @default("")
  photoUrl      String?
  license       String    @default("")
  emergency     String    @default("")
  bloodNote     String    @default("")
  subStatus     SubStatus @default(PENDING_PAYMENT)
  subExpiresAt  DateTime?
  regPaid       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  doctors       Doctor[]
  accommodations Accommodation[]
  tests         DiagnosticTest[]
  blood         BloodStock[]
  bookings      Booking[]
  payments      Payment[]
}

model Doctor {
  id            String   @id @default(cuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name          String
  photoUrl      String?
  specialty     String
  qualification String   @default("")
  experience    Int?
  feeBdt        Int
  visitingDays  String   @default("")
  visitingHours String   @default("")
  slots         String   @default("")   // comma separated, e.g. "17:00,17:30,18:00"
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  @@index([hospitalId])
}

model Accommodation {
  id             String   @id @default(cuid())
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  category       String
  name           String   @default("")
  unit           String   @default("")
  total          Int
  available      Int
  pricePerDay    Int
  additionalCharge Int    @default(0)
  deposit        Int      @default(0)
  ac             Boolean?
  sharing        String   @default("PRIVATE")
  occupants      Int      @default(1)
  attachedBath   Boolean  @default(false)
  facilityLevel  String   @default("STANDARD")
  equipment      String   @default("")
  notes          String   @default("")
  published      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  @@index([hospitalId])
}

model DiagnosticTest {
  id            String   @id @default(cuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name          String
  category      String   @default("")
  priceBdt      Int
  preparation   String   @default("")
  availableDays String   @default("")
  slots         String   @default("")
  collection    String   @default("LAB")   // "LAB" or "LAB,HOME"
  reportTime    String   @default("")
  published     Boolean  @default(true)
  @@index([hospitalId])
}

model BloodStock {
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  group      String
  units      Int      @default(0)
  updatedAt  DateTime @updatedAt
  @@id([hospitalId, group])
}

model Booking {
  id          String        @id @default(cuid())
  patientId   String
  patient     User          @relation(fields: [patientId], references: [id])
  hospitalId  String
  hospital    Hospital      @relation(fields: [hospitalId], references: [id])
  type        BookingType
  itemName    String
  itemRef     String?
  units       Int?
  startDate   DateTime?
  apptTime    String?
  days        Int?
  baseAmount  Int           @default(0)   // doctor fee / test price / accommodation estimate (paid to hospital)
  extraAmount Int           @default(0)   // admission/additional charges
  depositAmount Int         @default(0)
  feeBdt      Int                         // platform service fee
  status      BookingStatus @default(AWAITING_PAYMENT)
  note        String?
  hospitalNote String?
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([patientId])
  @@index([hospitalId, status])
}

model Payment {
  id                String     @id @default(cuid())
  purpose           PayPurpose
  amount            Int
  status            PayStatus  @default(INITIATED)
  provider          String     @default("bkash")
  providerPaymentId String?    @unique
  trxId             String?
  senderNumber      String?
  submittedTrx      String?    @unique
  userId            String?
  user              User?      @relation(fields: [userId], references: [id])
  hospitalId        String?
  hospital          Hospital?  @relation(fields: [hospitalId], references: [id])
  bookingId         String?
  booking           Booking?   @relation(fields: [bookingId], references: [id])
  ambulanceBookingId String?
  ambulanceBooking  AmbulanceBooking? @relation(fields: [ambulanceBookingId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  hospitalId String?
  action     String
  entity     String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  @@index([hospitalId])
  @@index([entity, entityId])
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

model AmbulanceProvider {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  area      String   @default("")
  phone     String   @default("")
  vehicles  Ambulance[]
  bookings  AmbulanceBooking[]
  createdAt DateTime @default(now())
}

model Ambulance {
  id         String   @id @default(cuid())
  providerId String
  provider   AmbulanceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type       String
  regNo      String   @default("")
  area       String   @default("")
  baseFare   Int
  perKm      Int      @default(0)
  notes      String   @default("")
  available  Boolean  @default(true)
  bookings   AmbulanceBooking[]
  createdAt  DateTime @default(now())
  @@index([providerId])
}

// Flow: PENDING -> provider ACCEPTED -> patient pays the BDT fee (verified) -> CONFIRMED -> COMPLETED
model AmbulanceBooking {
  id           String    @id @default(cuid())
  patientId    String
  patient      User      @relation(fields: [patientId], references: [id])
  providerId   String
  provider     AmbulanceProvider @relation(fields: [providerId], references: [id])
  ambulanceId  String
  ambulance    Ambulance @relation(fields: [ambulanceId], references: [id])
  type         String
  pickup       String
  destination  String
  contact      String
  requestedAt  DateTime
  fareText     String
  feeBdt       Int
  status       AmbStatus @default(PENDING)
  refundPending Boolean  @default(false)
  payments     Payment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([patientId])
  @@index([providerId, status])
}
